NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary (storage media aktif). Isi dari Console Cloudinary
# (Dashboard > Product Environment Credentials). JANGAN isi nilai di
# file ini dan jangan commit .env.local. Panduan: docs/CLOUDINARY.md.
# CLOUDINARY_API_SECRET adalah rahasia server-only: jangan pernah pakai
# prefix NEXT_PUBLIC_ dan jangan tampilkan di log atau chat.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder default upload admin (opsional; default margo-lestari/galeri).
CLOUDINARY_FOLDER=
